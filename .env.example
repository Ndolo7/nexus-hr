DATABASE_URL="postgresql://user:password@localhost:5432/nexus_hr"
REDIS_URL="redis://localhost:6379/0"

# Nexus auth
JWT_SECRET_KEY="replace-with-jwt-signing-secret"
JWT_ALGORITHM="HS256"
JWT_PUBLIC_KEY_PATH=""  # required when JWT_ALGORITHM is RS256/RS384/RS512
JWT_AUDIENCE=""
JWT_ISSUER=""
JWT_LEEWAY_SECONDS=30
JWT_EMPLOYEE_ID_CLAIM="employee_id"
JWT_EMAIL_CLAIM="email"
JWT_SUB_CLAIM="sub"
API_SECRET_KEY="replace-with-internal-service-secret"  # optional, for service-only endpoints

# ERPNext / Frappe connection
ERP_BASE_URL="https://erp.example.com"
ERP_API_KEY="replace-with-frappe-api-key"
ERP_API_SECRET="replace-with-frappe-api-secret"
ERP_AUTH_MODE="auto"  # auto | token | bearer | raw | none
ERP_AUTH_HEADER=""    # optional full header value, e.g. "token key:secret" or "Bearer <token>"
ERP_SITE_NAME=""      # optional, e.g. "site1.localhost" for Frappe Docker routing
ERP_VERIFY_SSL=true
ERP_TIMEOUT_SECONDS=15
ERP_WEBHOOK_SECRET="optional-webhook-hmac-secret"

# Google AI Studio API key
GOOGLE_API_KEY="AIza..."
GOOGLE_EMBEDDING_MODEL="models/text-embedding-004"
